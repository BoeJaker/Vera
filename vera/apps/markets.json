[
  {
    "id": "markets.overview",
    "panel": "markets",
    "title": "Markets overview",
    "icon": "chart",
    "summary": "The tracked universe by group - count, breadth and median moves",
    "view": {
      "kind": "table",
      "views": [
        "table",
        "cards",
        "chart"
      ]
    },
    "read": {
      "cap": "markets.overview",
      "args": {},
      "refresh": {
        "every_s": 60
      }
    },
    "related": [
      "markets.chart",
      "markets.lookup"
    ],
    "size": {
      "default": "m",
      "min": "s"
    }
  },
  {
    "id": "markets.symbol",
    "panel": "markets",
    "title": "Symbol",
    "icon": "chart",
    "summary": "One symbol's candles over time",
    "view": {
      "kind": "series",
      "views": [
        "trace",
        "area",
        "column",
        "table"
      ]
    },
    "read": {
      "cap": "markets.chart",
      "args": {
        "symbol": "{arg.symbol}"
      },
      "refresh": {
        "every_s": 30
      }
    },
    "related": [
      "markets.overview",
      "markets.lookup"
    ],
    "size": {
      "default": "l",
      "min": "m"
    }
  },
  {
    "id": "markets.watchlist",
    "panel": "markets",
    "title": "Watchlist",
    "icon": "chart",
    "summary": "The assets kept up to date - symbol, exchange, when each was last fetched and its bars",
    "view": {
      "kind": "table",
      "views": [
        "table",
        "cards"
      ]
    },
    "read": {
      "cap": "markets.watchlist.list",
      "args": {},
      "refresh": {
        "every_s": 60
      }
    },
    "actions": [
      {
        "id": "add",
        "label": "Add symbol",
        "cap": "markets.watchlist.add",
        "where": "header",
        "form": "schema",
        "fields": [
          {
            "key": "symbol",
            "label": "Symbol",
            "required": true
          },
          {
            "key": "exchange",
            "label": "Exchange",
            "default": "binance"
          }
        ],
        "args": {
          "backfill": true
        }
      },
      {
        "id": "remove",
        "label": "Remove",
        "cap": "markets.watchlist.remove",
        "where": "row",
        "confirm": true,
        "effect": "remove",
        "undo": "markets.watchlist.add",
        "undo_args": {"symbol": "{row.symbol}", "exchange": "{row.exchange}", "backfill": false},
        "args": {
          "symbol": "{row.symbol}",
          "exchange": "{row.exchange}"
        }
      }
    ],
    "detail": {
      "app": "markets.symbol",
      "args": {
        "symbol": "{row.symbol}"
      }
    },
    "related": [
      "markets.overview",
      "markets.chart"
    ],
    "size": {
      "default": "m",
      "min": "s"
    }
  },
  {
    "id": "markets.ticker",
    "panel": "markets",
    "title": "Ticker",
    "icon": "chart",
    "summary": "One symbol in one place - its candles, its news and how the news has read over time",
    "view": {
      "kind": "composite",
      "layout": "dashboard",
      "parts": [
        {
          "from": "chart",
          "kind": "series",
          "title": "Candles"
        },
        {
          "from": "news",
          "kind": "records",
          "title": "News"
        },
        {
          "from": "mood",
          "kind": "series",
          "title": "Sentiment"
        }
      ]
    },
    "read": [
      {
        "as": "chart",
        "cap": "markets.chart",
        "args": {
          "symbol": "{arg.symbol}"
        },
        "refresh": {
          "every_s": 60
        }
      },
      {
        "as": "news",
        "cap": "markets.news.feed",
        "args": {
          "symbol_key": "{arg.exchange}:{arg.symbol}",
          "limit": 8
        }
      },
      {
        "as": "mood",
        "cap": "markets.sentiment.history",
        "args": {
          "symbol_key": "{arg.exchange}:{arg.symbol}",
          "limit": 60
        }
      }
    ],
    "related": [
      "markets.symbol",
      "markets.watchlist"
    ],
    "size": {
      "default": "l",
      "min": "m"
    }
  }
]
