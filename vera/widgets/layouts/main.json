     "refresh": "30s"
    },
    "frame": {
     "size": "xl",
     "span": [
      12,
      5
     ],
     "max_body": null
    },
    "draw": {
     "body": "page"
    },
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "place": "dashboard",
    "note": "the page draws the estate's own <vera-topology-map> (status colour per node, click a node to open it, collapse a kind); the topology form draws a diagram of the graph without those hooks"
   },
