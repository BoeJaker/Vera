{
 "v": 2,
 "dashboard": "sysmon",
 "layout": "default",
 "key": "sysmon",
 "user": "",
 "grid": {
  "cols": 12,
  "row": 58,
  "gap": 10,
  "widths": [
   2,
   3,
   4,
   6,
   8,
   12
  ]
 },
 "note": "Stack Monitor as widget records (2026-09-27, \"everything should be widgetised\"): the three stacks with their KPIs and rows, the history series it charted by hand, the node temperatures. The classic view stays beside it on the page.",
 "widgets": [
  {
   "record": {
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "id": "sm-proxmox",
    "form": "composite",
    "source": "sysmon.status",
    "title": "Proxmox",
    "read": {
     "refresh": "10s"
    },
    "open": "estate/proxmox",
    "children": [
     {
      "slot": "a",
      "record": {
       "form": "kv",
       "source": "$subject.proxmox",
       "title": "guests",
       "read": {
        "map": {
         "keys": [
          "running",
          "guests",
          "nodes",
          "configured"
         ]
        }
       }
      }
     },
     {
      "slot": "b",
      "record": {
       "form": "meter",
       "source": "$subject.proxmox",
       "title": "memory",
       "read": {
        "map": {
         "value": "mem_used_gb",
         "max": "mem_total_gb"
        }
       },
       "draw": {
        "unit": "GB"
       }
      }
     },
     {
      "slot": "c",
      "record": {
       "form": "rows",
       "source": "$subject.proxmox.top_guests",
       "title": "busiest guests",
       "read": {
        "map": {
         "name": "name",
         "status": "status",
         "cpu": "cpu",
         "mem": "mem"
        }
       },
       "draw": {
        "columns": [
         "name",
         "status",
         "cpu",
         "mem"
        ]
       }
      }
     },
     {
      "slot": "d",
      "record": {
       "form": "trace",
       "source": "sysmon.history",
       "title": "memory %",
       "read": {
        "map": {
         "series": "samples",
         "v": "pmx_mem_pct"
        }
       },
       "draw": {
        "unit": "%"
       }
      }
     }
    ],
    "frame": {
     "size": "m",
     "span": [
      4,
      5
     ]
    },
    "draw": {
     "body": "record"
    }
   },
   "span": [
    4,
    5
   ],
   "hidden": false,
   "refresh": "10s",
   "floated": false
  },
  {
   "record": {
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "id": "sm-docker",
    "form": "composite",
    "source": "sysmon.status",
    "title": "Docker",
    "read": {
     "refresh": "10s"
    },
    "open": "estate/docker",
    "children": [
     {
      "slot": "a",
      "record": {
       "form": "kv",
       "source": "$subject.docker",
       "title": "containers",
       "read": {
        "map": {
         "keys": [
          "running",
          "containers",
          "reachable",
          "total_hosts"
         ]
        }
       }
      }
     },
     {
      "slot": "b",
      "record": {
       "form": "rows",
       "source": "$subject.docker.hosts",
       "title": "hosts",
       "read": {
        "map": {
         "name": "label",
         "kind": "kind",
         "reachable": "reachable",
         "error": "error",
         "running": "running",
         "containers": "containers"
        }
       },
       "draw": {
        "columns": [
         "name",
         "kind",
         "reachable",
         "error",
         "running",
         "containers"
        ]
       }
      }
     },
     {
      "slot": "c",
      "record": {
       "form": "trace",
       "source": "sysmon.history",
       "title": "running",
       "read": {
        "map": {
         "series": "samples",
         "v": "dkr_running"
        }
       }
      }
     }
    ],
    "frame": {
     "size": "m",
     "span": [
      4,
      5
     ]
    },
    "draw": {
     "body": "record"
    }
   },
   "span": [
    4,
    5
   ],
   "hidden": false,
   "refresh": "10s",
   "floated": false
  },
  {
   "record": {
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "id": "sm-ollama",
    "form": "composite",
    "source": "sysmon.status",
    "title": "Ollama",
    "read": {
     "refresh": "10s"
    },
    "open": "models",
    "children": [
     {
      "slot": "a",
      "record": {
       "form": "kv",
       "source": "$subject.ollama",
       "title": "nodes",
       "read": {
        "map": {
         "keys": [
