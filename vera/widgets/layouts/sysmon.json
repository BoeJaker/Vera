          "total",
          "gpu",
          "in_use"
         ]
        }
       }
      }
     },
     {
      "slot": "b",
      "record": {
       "form": "rows",
       "source": "$subject.ollama.nodes",
       "title": "nodes",
       "read": {
        "map": {
         "name": "label",
         "status": "status",
         "latency_ms": "latency_ms",
         "models": "models",
         "in_use": "in_use",
         "has_gpu": "has_gpu"
        }
       },
       "draw": {
        "columns": [
         "name",
         "status",
         "latency_ms",
         "models",
         "in_use",
         "has_gpu"
        ]
       }
      }
     },
     {
      "slot": "c",
      "record": {
       "form": "rows",
       "source": "ollama.gate.status",
       "title": "GPU gate · held by node",
       "read": {
        "map": {
         "rows": "nodes",
         "name": "node",
         "value": "held",
         "status": "gated"
        }
       },
       "draw": {
        "columns": [
         "name",
         "value"
        ]
       }
      }
     }
    ],
    "frame": {
     "size": "m",
     "span": [
      4,
      5
     ]
    },
    "draw": {
     "body": "record"
    }
   },
   "span": [
    4,
    5
   ],
   "hidden": false,
   "refresh": "10s",
   "floated": false
  },
