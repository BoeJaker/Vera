      "record": {
       "form": "kv",
       "source": "$subject.transports",
       "title": "transports",
       "read": {}
      }
     },
     {
      "slot": "c",
      "record": {
       "form": "rows",
       "source": "$subject.nodes",
       "title": "nodes",
       "read": {
        "map": {
         "name": "name",
         "status": "status",
         "value": "rssi"
        }
       },
       "draw": {
        "limit": 3
       }
      }
     },
     {
      "slot": "d",
      "record": {
       "form": "rows",
       "source": "netsec.mesh.status",
