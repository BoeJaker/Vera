{
 "v": 2,
 "dashboard": "inference",
 "layout": "default",
 "key": "main-inference",
 "user": "",
 "grid": {"cols": 12, "row": 58, "gap": 10, "widths": [2, 3, 4, 6, 8, 12]},
 "note": "The Inference preset of the main dashboard: the GPU gate and who holds it, every Ollama instance and what it is doing, the routing statistics by model and job type, the request log as it runs, the model catalogue per node and the bench's results, the census. Every tile is a record read through the element; a sandbox reads these from prod one way.",
 "widgets": [
  {"record": {"id": "inf-gate", "form": "pills", "source": "obs.health", "shape": "values", "title": "GPU gate", "read": {"refresh": "5s", "map": {"values": "gpu_gate"}}, "frame": {"size": "m", "span": [3, 2]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [3, 2], "hidden": false, "refresh": "5s", "floated": false},
  {"record": {"id": "inf-census", "form": "pills", "source": "obs.health", "shape": "values", "title": "Census", "read": {"refresh": "10s", "map": {"values": "census"}}, "frame": {"size": "m", "span": [3, 2]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [3, 2], "hidden": false, "refresh": "10s", "floated": false},
  {"record": {"id": "inf-inuse", "form": "ring", "source": "sysmon.status", "shape": "level", "title": "Instances in use", "read": {"refresh": "5s", "map": {"value": "ollama.in_use", "max": "ollama.total"}}, "frame": {"size": "m", "span": [2, 2]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [2, 2], "hidden": false, "refresh": "5s", "floated": false},
  {"record": {"id": "inf-online", "form": "counter", "source": "sysmon.status", "shape": "level", "title": "Online", "read": {"refresh": "5s", "map": {"value": "ollama.online"}}, "frame": {"size": "m", "span": [2, 2]}, "draw": {"unit": "nodes", "body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [2, 2], "hidden": false, "refresh": "5s", "floated": false},
  {"record": {"id": "inf-gpu", "form": "counter", "source": "sysmon.status", "shape": "level", "title": "GPU nodes", "read": {"refresh": "5s", "map": {"value": "ollama.gpu"}}, "frame": {"size": "m", "span": [2, 2]}, "draw": {"unit": "gpu", "body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [2, 2], "hidden": false, "refresh": "5s", "floated": false},
  {"record": {"id": "inf-gate-nodes", "form": "table", "source": "ollama.gate.status", "shape": "items", "title": "The gate by node", "read": {"refresh": "5s", "map": {"rows": "nodes"}}, "frame": {"size": "xl", "span": [6, 3], "max_body": 160}, "draw": {"columns": ["node", "has_gpu", "gated", "capacity", "held", "free"], "body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [6, 3], "hidden": false, "refresh": "5s", "floated": false},
  {"record": {"id": "inf-instances", "form": "cards", "source": "ollama.instances", "shape": "items", "title": "Ollama instances", "read": {"refresh": "5s", "map": {"rows": "$", "name": "label", "status": "status", "latency_ms": "latency_ms", "in_use": "in_use", "errors": "errors"}}, "frame": {"size": "xl", "span": [6, 3]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [6, 3], "hidden": false, "refresh": "5s", "floated": false},
  {"record": {"id": "inf-routing", "form": "table", "source": "ollama.route_stats", "shape": "items", "title": "Routing · by model, instance and job type", "read": {"refresh": "15s", "map": {"rows": "stats"}}, "frame": {"size": "xl", "span": [8, 4], "max_body": 260}, "draw": {"columns": ["model", "instance", "job_type", "n", "ema_elapsed_s", "ema_tps", "ema_tokens"], "sort": "n", "body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [8, 4], "hidden": false, "refresh": "15s", "floated": false},
  {"record": {"id": "inf-log", "form": "feed", "source": "ollama.request_log", "shape": "events", "title": "Request log", "read": {"refresh": "10s", "map": {"events": "entries", "t": "ts", "kind": "instance", "text": "model"}}, "frame": {"size": "xl", "span": [4, 4]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [4, 4], "hidden": false, "refresh": "10s", "floated": false},
  {"record": {"id": "inf-catalog", "form": "composite", "source": "catalog.installed", "shape": "composite", "title": "Model catalogue", "read": {"refresh": "60s"}, "frame": {"size": "xl", "span": [6, 4]}, "draw": {"body": "record"}, "layout": "2x2", "children": [{"slot": "models", "record": {"id": "inf-catalog:models", "form": "counter", "source": "$subject", "title": "installed models", "shape": "level", "read": {"map": {"value": "total_models"}}}}, {"slot": "size", "record": {"id": "inf-catalog:size", "form": "counter", "source": "$subject", "title": "on disk", "shape": "level", "read": {"map": {"value": "total_size_gb"}}, "draw": {"unit": "GB"}}}, {"slot": "nodes", "record": {"id": "inf-catalog:nodes", "form": "rows", "source": "$subject.nodes", "title": "per node", "shape": "items", "read": {"map": {"name": "label", "status": "status", "gpu": "gpu_name", "free_gb": "disk_free_gb"}}}}], "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [6, 4], "hidden": false, "refresh": "60s", "floated": false},
  {"record": {"id": "inf-models", "form": "table", "source": "ollama.list_models", "shape": "items", "title": "Models per instance", "read": {"refresh": "60s", "map": {"rows": "$"}}, "frame": {"size": "xl", "span": [6, 4], "max_body": 200}, "draw": {"columns": ["name", "count", "status", "has_gpu", "url"], "body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [6, 4], "hidden": false, "refresh": "60s", "floated": false},
  {"record": {"id": "inf-bench", "form": "table", "source": "bench.results", "shape": "items", "title": "Bench · the leaderboard", "read": {"refresh": "120s", "map": {"rows": "results"}}, "frame": {"size": "xl", "span": [6, 4], "max_body": 240}, "draw": {"columns": ["model", "node_label", "role", "accuracy", "perf", "quant", "size_gb"], "sort": "accuracy", "body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [6, 4], "hidden": false, "refresh": "120s", "floated": false},
  {"record": {"id": "inf-routing-cfg", "form": "kv", "source": "ollama.routing.get", "shape": "values", "title": "Routing configuration", "read": {"refresh": "60s"}, "frame": {"size": "xl", "span": [6, 4], "max_body": 240}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [6, 4], "hidden": false, "refresh": "60s", "floated": false},
  {"record": {"id": "inf-queue", "form": "trace", "source": "sysmon.history", "shape": "series", "title": "Queue depth", "read": {"refresh": "10s", "map": {"series": "samples", "v": "queue"}}, "frame": {"size": "m", "span": [4, 2]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [4, 2], "hidden": false, "refresh": "10s", "floated": false},
  {"record": {"id": "inf-background", "form": "pills", "source": "background.status", "shape": "values", "title": "Background queue", "read": {"refresh": "15s", "map": {"values": "queue"}}, "frame": {"size": "m", "span": [4, 2]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [4, 2], "hidden": false, "refresh": "15s", "floated": false},
  {"record": {"id": "inf-embed", "form": "kv", "source": "ollama.embed_config", "shape": "values", "title": "Embedding", "read": {"refresh": "60s"}, "frame": {"size": "m", "span": [4, 2]}, "draw": {"body": "record"}, "actions": ["dive", "pin", "ask"], "place": "dashboard"}, "span": [4, 2], "hidden": false, "refresh": "60s", "floated": false}
 ]
}
