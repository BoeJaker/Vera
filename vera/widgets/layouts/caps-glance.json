{
 "v": 2,
 "dashboard": "caps-glance",
 "layout": "default",
 "key": "caps-glance",
 "user": "",
 "grid": {
  "cols": 12,
  "row": 58,
  "gap": 10,
  "widths": [
   2,
   3,
   4,
   6,
   8,
   12
  ]
 },
 "note": "Cap Hub with no capability chosen: the capabilities at a glance (an empty pane is a glance, not a blank).",
 "widgets": [
