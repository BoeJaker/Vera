    "title": "Capabilities · by module",
    "read": {
     "refresh": "5m",
     "map": {
      "parts": "modules",
      "name": "name",
      "value": "caps_added"
     }
    },
    "frame": {
     "size": "l",
     "span": [
      12,
      3
     ]
    },
    "draw": {
     "body": "record"
    },
    "open": "capabilities"
   },
   "at": [
    0,
    7
   ],
   "span": [
    12,
    3
   ],
   "hidden": false,
