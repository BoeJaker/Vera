{
 "v": 2,
 "dashboard": "observe",
 "layout": "default",
 "key": "wol-observe",
 "user": "",
 "grid": {
  "cols": 12,
  "row": 58,
  "gap": 10,
  "widths": [
   2,
   3,
   4,
   6,
   8,
   12
  ]
 },
 "note": "Observe, errors first: the last hour's warnings and errors (syslog.error_summary) lead, then the jobs band, the work and routing lists, the job stream, and the live event stream and system log as their own elements. Every tile is a record the element draws.",
 "widgets": [
  {
   "record": {
    "id": "obs-errors",
    "form": "counter",
    "source": "syslog.error_summary",
    "title": "Errors · last hour",
    "read": {
     "refresh": "15s",
     "map": {
      "value": "errors"
     }
    },
    "draw": {
     "body": "record",
     "what": "errors and criticals"
    },
    "open": "estate/observe",
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "note": "ERROR + CRITICAL entries in the system log over the last hour, from its errors stream",
    "frame": {
     "span": [
      2,
      2
     ]
    }
   },
   "at": [
    0,
    0
   ],
   "span": [
    2,
    2
   ],
   "hidden": false,
   "refresh": "15s",
   "floated": false
  },
  {
   "record": {
    "id": "obs-warnings",
    "form": "counter",
    "source": "syslog.error_summary",
    "title": "Warnings · last hour",
    "read": {
     "refresh": "15s",
     "map": {
      "value": "warnings"
     }
    },
    "draw": {
     "body": "record",
     "what": "warnings"
    },
    "open": "estate/observe",
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "frame": {
     "span": [
      2,
      2
     ]
    }
   },
   "at": [
    2,
    0
   ],
   "span": [
    2,
    2
   ],
   "hidden": false,
   "refresh": "15s",
   "floated": false
  },
  {
   "record": {
    "id": "obs-last-error",
    "form": "kv",
    "source": "syslog.error_summary",
    "title": "The last error",
    "read": {
     "refresh": "15s",
     "map": {
      "pick": {
       "capability": "last_error.cap_name",
       "when": "last_error.ts",
       "message": "last_error.message"
      }
     }
    },
    "draw": {
     "body": "record"
    },
    "open": "estate/observe",
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "frame": {
     "span": [
      4,
      2
     ]
    }
   },
   "at": [
    4,
    0
   ],
   "span": [
    4,
    2
   ],
   "hidden": false,
   "refresh": "15s",
   "floated": false
  },
  {
   "record": {
    "id": "obs-error-trend",
    "form": "trace",
    "source": "syslog.error_summary",
    "title": "Errors · per 5 minutes · last hour",
    "read": {
     "refresh": "30s",
     "map": {
      "series": "series",
      "t": "t",
      "v": "errors"
     }
    },
    "draw": {
     "body": "record"
    },
    "open": "estate/observe",
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
    ],
    "frame": {
     "span": [
      4,
      2
