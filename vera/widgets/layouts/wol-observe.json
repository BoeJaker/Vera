    "form": "log",
    "source": "syslog.error_summary",
    "title": "Warnings and errors · newest first",
    "read": {
     "refresh": "15s",
     "args": {
      "limit": 200
     },
     "map": {
      "events": "entries",
      "t": "ts",
      "kind": "level",
      "text": "message"
     }
    },
    "draw": {
     "body": "record"
    },
    "open": "estate/observe",
    "place": "dashboard",
    "actions": [
     "dive",
     "pin",
     "ask"
