# Vera host stack - the variables docker-compose.yml reads. Copy to .env and fill in (never commit .env).
POSTGRES_DB=<postgres: POSTGRES_DB>
POSTGRES_USER=<postgres: POSTGRES_USER>
POSTGRES_PASSWORD=<postgres: POSTGRES_PASSWORD>
CHROMA_SERVER_HOST=<chroma: CHROMA_SERVER_HOST>
CHROMA_DB_IMPL=<chroma: CHROMA_DB_IMPL>
NEO4J_AUTH=<neo4j: NEO4J_AUTH>
DOCKER_STEPCA_INIT_ACME=<step-ca: DOCKER_STEPCA_INIT_ACME>
DOCKER_STEPCA_INIT_PASSWORD=<step-ca: DOCKER_STEPCA_INIT_PASSWORD>
DOCKER_STEPCA_INIT_NAME=<step-ca: DOCKER_STEPCA_INIT_NAME>
DOCKER_STEPCA_INIT_DNS_NAMES=<step-ca: DOCKER_STEPCA_INIT_DNS_NAMES>
LLDAP_LDAP_BASE_DN=<lldap: LLDAP_LDAP_BASE_DN>
LLDAP_JWT_SECRET=<lldap: LLDAP_JWT_SECRET>
LLDAP_LDAP_USER_PASS=<lldap: LLDAP_LDAP_USER_PASS>
SEARXNG_REDIS_URL=<searxng: SEARXNG_REDIS_URL>
SEARXNG_BASE_URL=<searxng: SEARXNG_BASE_URL>
BUILDER_DEFAULT_FQBN=<vera-builder: BUILDER_DEFAULT_FQBN>
