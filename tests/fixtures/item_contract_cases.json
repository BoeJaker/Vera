{
  "_doc": "The item contract's cases (DEEP-29 11A.4 Decision 2): the Python half (vera/canvas/item_core.py, tests/test_item_core.py) and the JS half (vera/ui/vera_item.js, tests/test_vera_item.cjs) must give these exact answers.",
  "normalise": [
    {"name": "an old keyed block reads as a tile in the now band",
     "block": {"id": "bk_1", "type": "note", "key": "note:a", "state": "now", "size": "m", "content": {"text": "hi"}, "ts": "t1"},
     "want": {"key": "note:a", "id": "bk_1", "kind": "note", "content": {"text": "hi"}, "source": {}, "anchors": [], "state": "now",
              "face": "tile", "size": "m", "place": {}, "locked": false, "view": "", "group": {}, "folded": false, "ts": "t1", "score": null}},
    {"name": "a parked block with no face is a pill",
     "block": {"id": "bk_2", "type": "table", "key": "table:b", "state": "parked", "size": "s"},
     "want_fields": {"face": "pill", "state": "parked", "size": "s"}},
    {"name": "unknown values fall back rather than fail",
     "block": {"type": "code", "key": "code:c", "state": "lost", "size": "huge", "face": "blob", "view": "radar"},
     "want_fields": {"state": "now", "size": "m", "face": "tile", "view": ""}},
    {"name": "a result item carries its source so it can be run again",
     "block": {"type": "result", "key": "result:d", "content": {"cap": "fabric.query", "args": {"q": "x"}, "ms": 12, "ts": "t2"}},
     "want_fields": {"source": {"cap": "fabric.query", "args": {"q": "x"}, "ts": "t2", "ms": 12}}},
    {"name": "a stored place is clamped and its lock read out",
     "block": {"type": "note", "key": "note:e", "face": "window", "place": {"fx": 1.7, "fy": -2, "w": 9, "h": 260.4, "by": "person", "locked": true, "layer": "front"}},
     "want_fields": {"face": "window", "locked": true, "place": {"fx": 1.0, "fy": 0.0, "w": 34, "h": 260, "by": "person", "locked": true, "layer": "front"}}},
    {"name": "the latest anchor alone still reads as the anchors",
     "block": {"type": "note", "key": "note:f", "anchor": {"turn": "m3"}},
     "want_fields": {"anchors": [{"turn": "m3"}]}}
  ],
  "apply_set": [
    {"name": "a face and a view in one call",
     "block": {"type": "records", "key": "records:a", "state": "now"},
     "fields": {"face": "window", "view": "table"},
     "want": {"changed": {"face": "window", "view": "table"}, "prev": {"face": "tile", "view": null}, "problems": []}},
    {"name": "a place merges over the one it had",
     "block": {"type": "note", "key": "note:b", "place": {"fx": 0.2, "fy": 0.3, "w": 300, "h": 200, "by": "auto"}},
     "fields": {"place": {"fx": 0.62, "by": "person"}},
     "want": {"changed": {"place": {"fx": 0.62, "fy": 0.3, "w": 300, "h": 200, "by": "person"}},
              "prev": {"place": {"fx": 0.2, "fy": 0.3, "w": 300, "h": 200, "by": "auto"}}, "problems": []}},
    {"name": "lock is kept on the place",
     "block": {"type": "note", "key": "note:c"},
     "fields": {"locked": true},
     "want": {"changed": {"place": {"locked": true}}, "prev": {"place": null}, "problems": []}},
    {"name": "a tile asked of a parked item brings it back into the now band",
     "block": {"type": "note", "key": "note:d", "state": "parked"},
     "fields": {"face": "tile"},
     "want": {"changed": {"face": "tile", "state": "now"}, "prev": {"face": "pill", "state": "parked"}, "problems": []}},
    {"name": "nothing that moves writes nothing",
     "block": {"type": "note", "key": "note:e", "face": "tile", "size": "m"},
     "fields": {"face": "tile", "size": "m"},
     "want": {"changed": {}, "prev": {}, "problems": []}},
    {"name": "a bad value refuses the whole call",
     "block": {"type": "note", "key": "note:f"},
     "fields": {"face": "window", "size": "huge", "place": {"fx": "far"}},
     "want": {"changed": {}, "prev": {}, "problems": ["size must be one of xs|s|m|l|xl", "place.fx must be a number"]}},
    {"name": "an empty group separates",
     "block": {"type": "note", "key": "note:g", "group": {"id": "g1", "front": true}},
     "fields": {"group": {}},
     "want": {"changed": {"group": {}}, "prev": {"group": {"id": "g1", "front": true}}, "problems": []}},
    {"name": "fields outside the contract are ignored",
     "block": {"type": "note", "key": "note:h"},
     "fields": {"content": {"text": "no"}, "key": "other", "folded": true},
     "want": {"changed": {"folded": true}, "prev": {"folded": null}, "problems": []}},
    {"name": "the JSON lens's tree view is a view (WSU-58 S1)",
     "block": {"type": "json", "key": "json:a"}, "fields": {"view": "tree"},
     "want": {"changed": {"view": "tree"}, "prev": {"view": null}, "problems": []}},
    {"name": "the JSON lens's flat view is a view (WSU-58 S1)",
     "block": {"type": "json", "key": "json:b", "view": "tree"}, "fields": {"view": "flat"},
     "want": {"changed": {"view": "flat"}, "prev": {"view": "tree"}, "problems": []}},
    {"name": "the JSON lens's validate view is a view (WSU-58 S1)",
     "block": {"type": "json", "key": "json:c"}, "fields": {"view": "validate"},
     "want": {"changed": {"view": "validate"}, "prev": {"view": null}, "problems": []}},
    {"name": "an app's own drawn view is a view (WSU-58 S1)",
     "block": {"type": "app", "key": "app:d"}, "fields": {"view": "drawn"},
     "want": {"changed": {"view": "drawn"}, "prev": {"view": null}, "problems": []}},
    {"name": "an unknown view is refused",
     "block": {"type": "note", "key": "note:i"}, "fields": {"view": "radar"},
     "want": {"changed": {}, "prev": {}, "problems": ["view must be one of list|cards|table|graph|chart|chips|fields|code|structure|both|tree|flat|validate|drawn"]}}
  ]
}
