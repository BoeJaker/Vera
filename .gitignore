# Cleanup

# Dream per-cycle output workspaces (runtime artifacts)
vera/dream/outputs/

# Loop Lab CI/CD dev sandbox
.loop-lab-worktrees/
docker-compose.dev.yml

# Operator run artifacts (per-run observe/step screenshots) — ephemeral.
# The DOCUMENTATION screenshots under documentation/assets/ ARE tracked.
artifacts/operator/

# Loop-run artifacts (ephemeral, per-run output) and the runtime log directory
# (most of logs/ is already caught by *.log/*.log.* above, but non-.log files
# like orchestrator.out are not, which was leaving logs/ showing as untracked).
artifacts/loop-runs/
logs/

# Local runtime / machine-specific state — kept on disk, never tracked.
# .mcp.json hardcodes a host IP + UNC path to .vera/vera_mcp_bridge.py, so both
# are per-machine; the .vera_remote_* files are regenerated by the running app
# and otherwise churn on every run.
.mcp.json
.vera/
vera/ide/.vera_remote_*.json
vera/ide/.vera_claude_sessions_state.json
