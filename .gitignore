**/keys/
**client_secrets.json
**service.json

# Per-environment provenance stamp written host-side at bring-up (git sha/branch
# of the running deploy) for the git-less container to read. Never source.
.vera-provenance.json
*.db
*.db-shm
*.db-wal
*.claude

# Keep .claude private EXCEPT the Vera dev skills — those SHIP in the repo so any
# agent working on Vera (its own dev container) gets them. Everything else under
# .claude (projects/chat history, settings.local.json, worktrees, locks) stays
# ignored. LEADING SLASH anchors these to the repo ROOT only — an un-anchored
# `!.claude/` would un-ignore EVERY nested .claude dir (e.g. tools/*/.claude).
# Order matters: un-ignore the root dir, re-ignore its contents, re-include skills/.
!/.claude/
/.claude/*
!/.claude/skills/

lib/

**/chroma_store/**/
**/chroma_db/
**/archive/**/
**/vera_agent_memory/**/
**/vera_memory/
**/focus_boards/

**/Deprecated
**/deprecated/
**/lib/
**/plugins/
**/Notes/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.sqlite
**/*.db
**/*.log
**/*.log.*
**/*.jsonl
**/*.sqlite3

/bin
**.env
**/.env
**/secret/
**/.security_cache/
vera/mesh/firmware/bin/.cache/
**/.obsidian/
**/.vscode/
**/.trash/
**/.temp/

**/saved_html/**/

# Snyk Security Extension - AI Rules (auto-generated)
.github\instructions\snyk_rules.instructions.md
**recover-server.sh

# Cleanup

# Dream per-cycle output workspaces (runtime artifacts)
vera/dream/outputs/

# Loop Lab CI/CD dev sandbox
.loop-lab-worktrees/
docker-compose.dev.yml
# auto-generated per-branch sandbox composes (evolve.sandbox.spawn)
docker-compose.dev-*.yml

# Operator run artifacts (per-run observe/step screenshots) — ephemeral.
# The DOCUMENTATION screenshots under documentation/assets/ ARE tracked.
artifacts/operator/

# Loop-run artifacts (ephemeral, per-run output) and the runtime log directory
# (most of logs/ is already caught by *.log/*.log.* above, but non-.log files
# like orchestrator.out are not, which was leaving logs/ showing as untracked).
artifacts/loop-runs/
logs/

# Local runtime / machine-specific state — kept on disk, never tracked.
# .mcp.json hardcodes a host IP + UNC path to .vera/vera_mcp_bridge.py, so both
# are per-machine; the .vera_remote_* files are regenerated by the running app
# and otherwise churn on every run.
.mcp.json
.vera/
vera/ide/.vera_remote_*.json
vera/ide/.vera_claude_sessions_state.json

# Mesh firmware build binaries â€” large, and carry an embedded device key. Never commit.
vera/mesh/firmware/bin/*.bin
