# /etc/default/vera-inference — config for gpu-inference.service
#
# Copy to /etc/default/vera-inference on each node and pick a profile below.
# Vera health-probes every media node for which services it actually serves
# (/health -> whisper/tts/stable_diffusion) and routes GPU-first, least-busy,
# so a CPU node that offers only TTS is picked up automatically as overflow.

INFER_APP_DIR=/home/Servers/StableDiffustionWhisper

# The cache that already holds the models. Do not point this somewhere new
# unless you intend to re-download several gigabytes.
HF_HOME=/.cache/huggingface

# ── Profile: GPU node (V100 etc.) — everything on ────────────────────────────
ENABLE_WHISPER=1
ENABLE_TTS=1
ENABLE_SD=1
SD_DEVICE=cuda

# ── Profile: CPU node — TTS only ─────────────────────────────────────────────
# kokoro is kokoro-onnx and runs perfectly well on CPU, just slower. That is
# fine for background work: overnight narration, podcast voiceover, anything
# not waiting on a human. Stable Diffusion on CPU is impractically slow and
# Whisper adds load for little benefit, so both stay off.
#
# ENABLE_WHISPER=0
# ENABLE_TTS=1
# ENABLE_SD=0
# SD_DEVICE=cpu

# TTS_ENGINE=kokoro          # kokoro (default, CPU/GPU) | coqui
# WHISPER_MODEL=base
