# /etc/default/vera-node-agent — copy, then set the token. NEVER commit a real one.

# Shared secret for MUTATING calls (/node/runner/kill). Must match VERA_NODE_TOKEN
# in Vera's own environment (/home/boejaker/Vera/.env on the orchestrator host).
# With this unset the agent still reports, but refuses to kill anything — a node
# that cannot be told apart from an impostor should not be able to signal
# processes on someone's say-so. Generate with:  openssl rand -hex 32
VERA_NODE_TOKEN=

# What this node calls itself in Vera's output. Defaults to the hostname.
#VERA_NODE_NAME=cpu-247

# Bind address and port. Vera derives the address from the node's ollama URL,
# swapping the port for this one, so changing it means changing
# VERA_NODE_AGENT_PORT on the orchestrator too.
#VERA_NODE_BIND=0.0.0.0
#VERA_NODE_PORT=8770

# A runner computing for longer than this has outlived every client that could
# still be waiting, because they all abort at OLLAMA_GEN_TIMEOUT. Default 1800s
# = 2x the orchestrator's 900s, matching _sweep_stuck_running's reasoning.
# Advisory only: the agent never kills on its own, Vera decides.
#VERA_RUNNER_STUCK_S=1800

# Process names treated as compute workers, comma-separated. Add vllm/sglang
# here as they appear on the estate.
#VERA_RUNNER_NAMES=llama-server,ollama runner

# Local specialised-inference service (Whisper / TTS / Stable Diffusion), if this
# node has one. Reported by /node/media so Vera has ONE address per node for both
# "what are you doing" and "do this". Harmless on nodes without it.
#VERA_NODE_MEDIA_URL=http://127.0.0.1:8765
