#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
#  Vera pre-push — refuse FORCE / DESTRUCTIVE pushes to PROTECTED branches.
#  (documentation/specs/dev-lifecycle-and-repo-hygiene.md §3.)
#
#  Why: the llm.int GitHub deploy key gives prod (and anything running on it — a
#  loop, an agent, a stray script, a bug) the ability to PUSH. A force-push or a
#  branch deletion could rewrite or destroy shared history on main / bleeding-edge
#  on GitHub. This hook makes that impossible without a deliberate, explicit
#  human override. Fast-forward pushes (the normal case) are allowed untouched.
#
#  Enabled via `git config core.hooksPath tools/hooks`. Runs on EVERY push from
#  any checkout that carries this file (prod's `main` checkout and the Windows SMB
#  view share it). git feeds one line per ref on stdin:
#       <local ref>  <local sha>  <remote ref>  <remote sha>
#  (the shas are what git negotiated with the REAL remote, so this is not fooled
#  by a stale local tracking ref.)
#
#  Deliberate, reviewed history rewrite you are doing BY HAND, on purpose:
#       VERA_ALLOW_FORCE_PUSH=1 git push …
# ─────────────────────────────────────────────────────────────────────────────
protected="refs/heads/main refs/heads/bleeding-edge"
zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # only guard the protected branches; feature branches may be force-pushed
    case " $protected " in
        *" $remote_ref "*) : ;;
        *) continue ;;
    esac

    if [ "${VERA_ALLOW_FORCE_PUSH:-}" = "1" ]; then
        echo "pre-push: VERA_ALLOW_FORCE_PUSH=1 set — allowing override push to $remote_ref." >&2
        continue
    fi

    # deleting a protected branch (local side all-zero) — never
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: REFUSED — deleting protected branch '$remote_ref'." >&2
        echo "  Protected branches are never deleted from the remote." >&2
        status=1
        continue
    fi

    # creating the branch on the remote for the first time (remote side all-zero) — fine
    if [ "$remote_sha" = "$zero" ]; then
        continue
    fi

    # non-fast-forward = force = would rewrite shared history — never.
    # The remote tip MUST be an ancestor of what we are pushing.
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: REFUSED — NON-FAST-FORWARD (force) push to '$remote_ref'." >&2
        echo "  remote $remote_sha is not an ancestor of local $local_sha;" >&2
        echo "  this would rewrite / clobber shared history on the remote." >&2
        echo "  Rebase or merge the remote in first. For a deliberate, reviewed" >&2
        echo "  rewrite by hand:  VERA_ALLOW_FORCE_PUSH=1 git push …" >&2
        status=1
    fi
done

exit $status
